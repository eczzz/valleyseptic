---
import globalCssText from "../styles/global.css?raw";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import { SITE } from "../config/site";
import localBusinessJson from "../data/source-schema/local-business.json";
import type { PageMeta } from "../data/page-metadata";

export interface Props {
  /** Pass the whole PageMeta object — all head fields derive from it. */
  meta?: PageMeta;

  /** Per-field overrides (used when no PageMeta is available). */
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number | string;
  ogImageHeight?: number | string;
  ogImageType?: string;
  ogImageAlt?: string;
  twitterImage?: string;
  ogType?: "website" | "article";
  ogUpdatedTime?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  robots?: string;
  schema?: unknown[] | Record<string, unknown>;
  bodyClass?: string;
  /** Class to apply to <main id="main">. SourcePort pages pass "clearfix width-100"
   *  so Avada's .width-100 negative-margin breakout rules apply to fullwidth sections. */
  mainClass?: string;
  /** When true, skip the Astro Header/Footer/<main> shell — the slot is expected
   *  to render the full Avada body structure (boxed-wrapper > wrapper > tb-header,
   *  main, tb-footer). Used by PortPage. */
  portMode?: boolean;
  /** Port CSS file paths (/port-css/*.css). Emitted as <link rel="preload"
   *  as="style"> in <head> so the browser starts fetching them immediately
   *  instead of when it parses down to the body-level <link rel="stylesheet">. */
  portCss?: string[];
}

const p = Astro.props;
const m = p.meta;

const title = p.title ?? m?.title ?? SITE.fullName;
const description = p.description ?? m?.description ?? SITE.defaultDescription;
const canonical = p.canonical ?? m?.canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = p.ogImage ?? m?.ogImage ?? (SITE.url + SITE.ogImage);
const ogImageWidth = String(p.ogImageWidth ?? m?.ogImageWidth ?? 1000);
const ogImageHeight = String(p.ogImageHeight ?? m?.ogImageHeight ?? 300);
const ogImageType = p.ogImageType ?? m?.ogImageType ?? "image/webp";
const ogImageAlt = p.ogImageAlt ?? m?.h1;
const twitterImage = p.twitterImage ?? m?.twitterImage ?? ogImage;
const ogType = p.ogType ?? m?.ogType ?? "website";
const ogUpdatedTime = p.ogUpdatedTime ?? m?.modifiedDate;
// Source (Rank Math) emits article:published_time / article:modified_time on
// every page including og:type=website — replicate that.
const articlePublishedTime = p.articlePublishedTime ?? m?.publishedDate;
const articleModifiedTime = p.articleModifiedTime ?? m?.modifiedDate;
const articleAuthor = p.articleAuthor ?? (m?.isPost ? m?.author : undefined);
const articleSection = p.articleSection ?? (m?.isPost ? m?.category : undefined);
const robots = p.robots ?? "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large";
const schema = p.schema;
const bodyClass = p.bodyClass ?? "";
const mainClass = p.mainClass ?? "";
const portMode = p.portMode ?? false;
const portCss = p.portCss ?? [];

// Follow-up pass — de-render-block the port CSS (the real cause of the hero H1's
// LCP render delay: the ~83 KB render-blocking wpr+fusion CSS gates FCP and
// starves the hero font). The ABOVE-THE-FOLD critical subset of each port
// stylesheet (rules matching visible above-fold elements at 360+1280, unioned
// across all pages that use the file) is inlined in <head> so first paint is
// fully styled with no blocking request; the full stylesheets then load
// non-render-blocking (preload -> stylesheet) to backfill below-the-fold rules.
const criticalRaw = import.meta.glob("../data/source-port-critical/*.css", {
  query: "?raw", import: "default", eager: true,
}) as Record<string, string>;
const portCssCritical = portCss
  .map((href) => criticalRaw["../data/source-port-critical/" + href.split("/").pop()] ?? "")
  .join("\n");

const schemaJson = schema ? (Array.isArray(schema) ? schema : [schema]) : null;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : SITE.url + ogImage;
const twitterImageAbsolute = twitterImage.startsWith("http") ? twitterImage : SITE.url + twitterImage;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {SITE.gtmId && (
      <!-- Google Tag Manager (Step 4 — deferred off the critical path) -->
      <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
        (function(w,d,s,l,i){
          w[l]=w[l]||[];
          var done=false;
          function load(){
            if(done)return; done=true;
            w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
            var f=d.getElementsByTagName(s)[0],j=d.createElement(s),
                dl=l!='dataLayer'?'&l='+l:'';
            j.async=true; j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
            f.parentNode.insertBefore(j,f);
          }
          // Load on first interaction, or — for sessions with no interaction, so
          // analytics still records — when the main thread is idle after load.
          // GTM (and the GA4/gtag tag it fires) keep the same IDs, just later.
          ['pointerdown','keydown','touchstart','scroll','wheel','mousemove'].forEach(function(e){
            w.addEventListener(e,load,{once:true,passive:true});
          });
          function afterLoad(){ 'requestIdleCallback' in w ? w.requestIdleCallback(load,{timeout:4000}) : setTimeout(load,3000); }
          if(d.readyState==='complete') afterLoad();
          else w.addEventListener('load',afterLoad);
        })(window,document,'script','dataLayer',gtmId);
      </script>
      <!-- End Google Tag Manager -->
    )}
    <style set:html={globalCssText}></style>
    {/* Inlined above-the-fold critical port CSS (after global.css so Avada port
        rules win same-specificity conflicts, exactly as the body-level <link>
        did). The full sheets load async below. */}
    {portCssCritical && <style set:html={portCssCritical}></style>}
    {/* Step 1 — critical responsive-typography reproduction.
        Avada sizes `.fusion-responsive-typography-calculated` headings (the hero
        H1 is the LCP element) via a CSS formula whose only viewport-dependent
        terms are multiplied by `--typography_sensitivity`, which is 0 site-wide
        (verified across every port stylesheet). The formula therefore reduces
        exactly to `var(--fontSize) * 1px`. Inlining that here sets each heading's
        size pre-paint from its own inline `--fontSize` — needing neither the
        Fusion JS bundle nor the (Step 5) now-async port CSS, so the H1 paints at
        its final size immediately and never resizes. 0px match vs. baseline at
        360/414/768/1024/1280/1440. */}
    <style>.fusion-responsive-typography-calculated{font-size:calc(var(--fontSize) * 1px) !important}</style>
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.fullName} />
    {ogUpdatedTime && <meta property="og:updated_time" content={ogUpdatedTime} />}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:secure_url" content={ogImageAbsolute} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:image:type" content={ogImageType} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageAbsolute} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts (Step 3 — self-hosted; fonts.gstatic CDN removed) -->
    {portMode && (
      <>
        <link rel="preconnect" href="https://valleyseptic.ca" />
        {/* Preload the hero H1 webfont (Oswald 500, latin subset) so the LCP
            text paints in its final face with no gstatic round-trip and no swap.
            crossorigin is required even same-origin — fonts fetch in CORS mode. */}
        <!-- font preload removed (test) -->
      </>
    )}
    {/* Non-port pages used the fonts.googleapis CDN for Open Sans / Oswald /
        Barlow Condensed (400–700). Now served from self-hosted woff2 with
        font-display:swap. Port pages get these @font-face from their port CSS. */}
    {!portMode && <link rel="stylesheet" href="/fonts/google.css" />}

    {/* Load the FULL port stylesheets non-render-blocking: preload (fetched
        immediately, in parallel) then flip to a stylesheet on load. First paint
        is already styled by the inlined above-the-fold critical CSS; this
        backfills the below-the-fold rules without gating the hero paint or
        starving the hero font. <noscript> keeps it working with JS disabled. */}
    {portCss.map(href => (
      <link rel="preload" as="style" href={href} onload="this.onload=null;this.rel='stylesheet'" />
    ))}
    {portCss.length > 0 && (
      <noscript set:html={portCss.map(href => `<link rel="stylesheet" href="${href}">`).join("")}></noscript>
    )}

    {schemaJson && schemaJson.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJson)} />
  </head>
  <body class={bodyClass}>
    {SITE.gtmId && (
      <!-- Google Tag Manager (noscript) -->
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}></noscript>
      <!-- End Google Tag Manager (noscript) -->
    )}
    <a href="#main" class="sr-only">Skip to content</a>
    {portMode && <slot />}
    {!portMode && (
      <>
        <Header />
        <div id="wrapper" class="fusion-wrapper">
          <main id="main" class={mainClass}>
            <slot />
          </main>
        </div>
        <Footer />
      </>
    )}

    <script is:inline>
      /* Step 2 — vanilla mobile-menu shim. The heavy Fusion bundle is now
         deferred to first interaction (SourcePort), but it was the bundle that
         (a) switched the nav into mobile "collapse" mode and (b) handled the
         hamburger / submenu toggles. This replicates that pre-boot so the mobile
         menu is correct and usable from first paint — and it removes the ~2.5s
         window where the menu was previously stuck in its un-initialised
         `loading` state. Faithfully mirrors Avada's fusionNavIsCollapsed,
         fusionNavClickExpandBtn and fusionNavMobilePosition. Once the bundle
         boots (window.__portBooted) it hands control back to Avada. */
      (function () {
        function navs() { return document.querySelectorAll('nav.awb-menu'); }
        function sbw() { return Math.max(0, window.innerWidth - document.documentElement.clientWidth); }

        // (a) responsive collapse — matches fusionNavIsCollapsed (innerWidth <= data-breakpoint)
        function applyCollapse(nav) {
          nav.classList.remove('loading');
          nav.classList.add('awb-menu_mobile-accordion'); // built-in accordion mode (missing in source)
          var bp = parseInt(nav.getAttribute('data-breakpoint') || '1024', 10);
          if (window.innerWidth <= bp) {
            nav.classList.add('collapse-enabled');
            nav.classList.remove('awb-menu_desktop');
          } else {
            nav.classList.remove('collapse-enabled');
            nav.classList.add('awb-menu_desktop');
          }
          // NOTE: position() is intentionally NOT called on init. The closed
          // mobile menu has height 0 (invisible), so its left offset is
          // irrelevant until it opens — and calling getBoundingClientRect here
          // forced a synchronous reflow before first paint (the (index):878 cost).
          // position() now runs only in expand() when the menu is actually opened.
        }
        function initAll() { if (window.__portBooted) return; navs().forEach(applyCollapse); }

        // (c) position the full-width absolute mobile menu — matches fusionNavMobilePosition
        function position(nav) {
          if (!nav || !nav.classList || !nav.classList.contains('mobile-size-full-absolute')) return;
          var ul = nav.querySelector(':scope > ul.awb-menu__main-ul') || nav.querySelector('.awb-menu__main-ul');
          if (!ul) return;
          if (nav.classList.contains('collapse-enabled')) {
            var rect = ul.getBoundingClientRect();
            var curLeft = parseFloat(getComputedStyle(ul).left) || 0;
            ul.style.left = (curLeft - rect.left) + 'px';      // jQuery offset({left:0})
            ul.style.width = 'calc(100vw - ' + sbw() + 'px)';
          } else {
            ul.style.width = ''; ul.style.left = ''; ul.style.right = '';
          }
        }

        // (b) expand/collapse a toggle — matches fusionNavClickExpandBtn
        function expand(btn) {
          var parent = btn.parentElement;
          var open = parent.classList.toggle('expanded');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          parent.querySelectorAll('ul > li > a, ul > li > button').forEach(function (el) {
            if (open) el.removeAttribute('tabindex'); else el.setAttribute('tabindex', '-1');
          });
          // Mobile submenu: Avada reveals the nested <ul> via JS (jQuery slideToggle
          // sets display) — there is no CSS rule keyed on `.expanded` alone — so
          // mirror that. No-op for the hamburger, whose <ul> is the main menu
          // (revealed by the collapse-enabled max-height rule).
          var subUl = parent.querySelector(':scope > ul.awb-menu__sub-ul');
          if (subUl) subUl.style.display = open ? 'block' : 'none';
          position(parent); // parent === nav for the hamburger; no-op for submenu <li>
        }

        document.addEventListener('click', function (e) {
          if (window.__portBooted) return; // Avada owns it now
          var t = e.target;
          var btn = t && t.closest && t.closest(
            '.awb-menu__m-toggle, .awb-menu__open-nav-submenu_mobile, .awb-menu__open-nav-submenu_main');
          if (!btn) return;
          var nav = btn.closest('nav.awb-menu');
          if (!nav || !nav.classList.contains('collapse-enabled')) return; // mobile mode only
          e.preventDefault();
          expand(btn); // fully shim-driven; the tap's pointerdown already boots the bundle in bg
        }, false);

        initAll();
        window.addEventListener('resize', initAll, { passive: true });
      })();
    </script>

    <script is:inline>
      // Scroll-triggered fade-in for `.reveal` elements. Matches the Avada
      // source which animates section content in via fadeInUp on scroll.
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          els.forEach(el => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
        els.forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
