---
import globalCssText from "../styles/global.css?raw";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import { SITE } from "../config/site";
import localBusinessJson from "../data/source-schema/local-business.json";
import type { PageMeta } from "../data/page-metadata";

export interface Props {
  /** Pass the whole PageMeta object — all head fields derive from it. */
  meta?: PageMeta;

  /** Per-field overrides (used when no PageMeta is available). */
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number | string;
  ogImageHeight?: number | string;
  ogImageType?: string;
  ogImageAlt?: string;
  twitterImage?: string;
  ogType?: "website" | "article";
  ogUpdatedTime?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  robots?: string;
  schema?: unknown[] | Record<string, unknown>;
  bodyClass?: string;
  /** Class to apply to <main id="main">. SourcePort pages pass "clearfix width-100"
   *  so Avada's .width-100 negative-margin breakout rules apply to fullwidth sections. */
  mainClass?: string;
  /** When true, skip the Astro Header/Footer/<main> shell — the slot is expected
   *  to render the full Avada body structure (boxed-wrapper > wrapper > tb-header,
   *  main, tb-footer). Used by PortPage. */
  portMode?: boolean;
  /** Port CSS file paths (/port-css/*.css). Emitted as <link rel="preload"
   *  as="style"> in <head> so the browser starts fetching them immediately
   *  instead of when it parses down to the body-level <link rel="stylesheet">. */
  portCss?: string[];
}

const p = Astro.props;
const m = p.meta;

const title = p.title ?? m?.title ?? SITE.fullName;
const description = p.description ?? m?.description ?? SITE.defaultDescription;
const canonical = p.canonical ?? m?.canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = p.ogImage ?? m?.ogImage ?? (SITE.url + SITE.ogImage);
const ogImageWidth = String(p.ogImageWidth ?? m?.ogImageWidth ?? 1000);
const ogImageHeight = String(p.ogImageHeight ?? m?.ogImageHeight ?? 300);
const ogImageType = p.ogImageType ?? m?.ogImageType ?? "image/webp";
const ogImageAlt = p.ogImageAlt ?? m?.h1;
const twitterImage = p.twitterImage ?? m?.twitterImage ?? ogImage;
const ogType = p.ogType ?? m?.ogType ?? "website";
const ogUpdatedTime = p.ogUpdatedTime ?? m?.modifiedDate;
// Source (Rank Math) emits article:published_time / article:modified_time on
// every page including og:type=website — replicate that.
const articlePublishedTime = p.articlePublishedTime ?? m?.publishedDate;
const articleModifiedTime = p.articleModifiedTime ?? m?.modifiedDate;
const articleAuthor = p.articleAuthor ?? (m?.isPost ? m?.author : undefined);
const articleSection = p.articleSection ?? (m?.isPost ? m?.category : undefined);
const robots = p.robots ?? "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large";
const schema = p.schema;
const bodyClass = p.bodyClass ?? "";
const mainClass = p.mainClass ?? "";
const portMode = p.portMode ?? false;
const portCss = p.portCss ?? [];

const schemaJson = schema ? (Array.isArray(schema) ? schema : [schema]) : null;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : SITE.url + ogImage;
const twitterImageAbsolute = twitterImage.startsWith("http") ? twitterImage : SITE.url + twitterImage;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {SITE.gtmId && (
      <!-- Google Tag Manager -->
      <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
      <!-- End Google Tag Manager -->
    )}
    <style set:html={globalCssText}></style>
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.fullName} />
    {ogUpdatedTime && <meta property="og:updated_time" content={ogUpdatedTime} />}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:secure_url" content={ogImageAbsolute} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:image:type" content={ogImageType} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageAbsolute} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts / preconnects -->
    {portMode && (
      <link rel="preconnect" href="https://valleyseptic.ca" />
    )}
    {!portMode && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap"
        />
      </>
    )}

    {/* Preload the ported Avada CSS so the browser fetches it immediately,
        in parallel — instead of waiting until it parses to the body-level
        <link rel="stylesheet"> that SourcePort emits. */}
    {portCss.map(href => <link rel="preload" as="style" href={href} />)}

    {schemaJson && schemaJson.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJson)} />
  </head>
  <body class={bodyClass}>
    {SITE.gtmId && (
      <!-- Google Tag Manager (noscript) -->
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}></noscript>
      <!-- End Google Tag Manager (noscript) -->
    )}
    <a href="#main" class="sr-only">Skip to content</a>
    {portMode && <slot />}
    {!portMode && (
      <>
        <Header />
        <div id="wrapper" class="fusion-wrapper">
          <main id="main" class={mainClass}>
            <slot />
          </main>
        </div>
        <Footer />
      </>
    )}

    <script is:inline>
      // Avada has a built-in mobile accordion mode that collapses open submenus
      // when a new one is tapped — it's gated on the nav having the class
      // awb-menu_mobile-accordion, which is just missing from the source HTML.
      document.querySelectorAll('.awb-menu').forEach(function(nav) {
        nav.classList.add('awb-menu_mobile-accordion');
      });
    </script>

    <script is:inline>
      // Scroll-triggered fade-in for `.reveal` elements. Matches the Avada
      // source which animates section content in via fadeInUp on scroll.
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          els.forEach(el => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
        els.forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
