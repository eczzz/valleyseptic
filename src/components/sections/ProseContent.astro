---
export interface Props {
  html: string;
  background?: "default" | "alt" | "cream";
}

const { html, background = "default" } = Astro.props;
const bgClass = background === "alt" ? "section--alt" : background === "cream" ? "section--cream" : "";
---
<section class={`section prose-section ${bgClass}`}>
  <div class="container">
    <div class="prose" set:html={html} />
  </div>
</section>

<style>
  .prose-section .prose img { width: 100%; height: auto; }
  .prose-section .prose table { width: 100%; border-collapse: collapse; margin: 1.5em 0; }
  .prose-section .prose th, .prose-section .prose td { padding: 12px 16px; border: 1px solid var(--c-border); text-align: left; }
  .prose-section .prose th { background: var(--c-bg-alt); font-family: var(--font-heading); }
</style>
