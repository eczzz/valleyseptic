---
export interface PostTeaser {
  title: string;
  excerpt: string;
  href: string;
  image: string;
  date: string;
  author?: string;
}

export interface Props {
  title?: string;
  posts: PostTeaser[];
  background?: "default" | "alt" | "cream";
}

const { title = "Our Articles", posts, background = "cream" } = Astro.props;
const bgClass = background === "alt" ? "section--alt" : background === "cream" ? "section--cream" : "";
---
<section class={`section blog-teasers ${bgClass}`}>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
    </div>
    <div class="grid grid-3">
      {posts.map(p => (
        <article class="post-card">
          <a href={p.href} class="post-card__image">
            <img src={p.image} alt={p.title} loading="lazy" />
          </a>
          <div class="post-card__body">
            <h4 class="post-card__title"><a href={p.href}>{p.title}</a></h4>
            <p class="post-card__meta">{p.date}{p.author ? ` · ${p.author}` : ""}</p>
            <p class="post-card__excerpt">{p.excerpt}</p>
            <a href={p.href} class="post-card__cta">Read more
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1l4 4-4 4M13 5H1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .post-card {
    background: var(--c-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--c-border);
    transition: transform 200ms ease, box-shadow 200ms ease;
    display: flex;
    flex-direction: column;
  }
  .post-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .post-card__image {
    display: block;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--c-cream);
  }
  .post-card__image img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  .post-card:hover .post-card__image img { transform: scale(1.04); }
  .post-card__body { padding: var(--space-5); flex: 1; display: flex; flex-direction: column; }
  .post-card__title { font-size: 20px; line-height: 1.3; margin: 0 0 8px; }
  .post-card__title a { color: inherit; text-decoration: none; }
  .post-card__title a:hover { color: var(--c-primary); }
  .post-card__meta { font-size: 13px; color: var(--c-text-muted); margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  .post-card__excerpt { font-size: 15px; color: var(--c-text-muted); margin: 0 0 var(--space-4); flex: 1; }
  .post-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-primary);
  }
</style>
