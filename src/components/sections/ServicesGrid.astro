---
export interface ServiceItem {
  title: string;
  text: string;
  href: string;
  icon?: string;
  image?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  items: ServiceItem[];
  variant?: "overlay" | "card";
}

const { eyebrow, title, lede, items, variant = "overlay" } = Astro.props;
const cols = items.length === 5 ? 5 : items.length === 3 ? 3 : 4;
---
<section class="section services">
  <div class="container">
    {(eyebrow || title || lede) && (
      <div class="section-header">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="section-title">{title}</h2>}
        {lede && <p class="section-lede">{lede}</p>}
      </div>
    )}
    <div class={`grid grid-${cols} services__grid`}>
      {items.map((s, i) => (
        <a href={s.href} class={`service-card service-card--${variant} reveal`} style={`--delay: ${i * 90}ms;`}>
          {s.image && (
            <div class="service-card__image">
              <img src={s.image} alt={s.title} loading="lazy" />
              <div class="service-card__overlay"></div>
            </div>
          )}
          <div class="service-card__body">
            {s.icon && <div class="service-card__icon">{s.icon}</div>}
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__text">{s.text}</p>
            <span class="service-card__cta">Learn More
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1l4 4-4 4M13 5H1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }
  .service-card:hover { transform: translateY(-4px); }

  /* OVERLAY VARIANT — image fills card, text overlaid on dark gradient */
  .service-card--overlay {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    color: var(--c-white);
    box-shadow: var(--shadow-md);
  }
  .service-card--overlay .service-card__image {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }
  .service-card--overlay .service-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .service-card--overlay:hover .service-card__image img { transform: scale(1.06); }
  .service-card--overlay .service-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(50,22,31,0) 0%,
      rgba(50,22,31,0.55) 50%,
      rgba(50,22,31,0.92) 100%);
  }
  .service-card--overlay .service-card__body {
    position: relative;
    margin-top: auto;
    padding: var(--space-5);
    z-index: 1;
  }
  .service-card--overlay .service-card__title {
    color: var(--c-white);
    font-size: 22px;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 var(--space-2);
  }
  .service-card--overlay .service-card__text {
    color: rgba(255,255,255,0.88);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 var(--space-3);
  }
  .service-card--overlay .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-tan);
  }
  .service-card--overlay:hover .service-card__cta svg { transform: translateX(4px); }
  .service-card--overlay .service-card__cta svg { transition: transform 200ms ease; }

  /* CARD VARIANT (default fallback — light bordered card) */
  .service-card--card {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }
  .service-card--card .service-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .service-card--card .service-card__image img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .service-card--card .service-card__body { padding: var(--space-5); flex: 1; display: flex; flex-direction: column; }
  .service-card--card .service-card__title { font-size: 22px; margin: 0 0 var(--space-2); }
  .service-card--card .service-card__text { font-size: 15px; color: var(--c-text-muted); margin: 0 0 var(--space-4); flex: 1; }
  .service-card--card .service-card__cta {
    color: var(--c-primary);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
